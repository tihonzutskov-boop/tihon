# Copy to .env for local development. On Render, set these as service
# environment variables instead (DATABASE_URL is filled in automatically
# when the web service is linked to the Postgres instance).

# Postgres connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/gym_cartographer

# Google OAuth Client ID (Web application type, no client secret needed).
# Same value goes in both — GOOGLE_CLIENT_ID is read by the backend to verify
# tokens, VITE_GOOGLE_CLIENT_ID is baked into the frontend build. Not secret.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Signs session cookies. On Render this is auto-generated; for local dev
# any random string works.
SESSION_SECRET=dev-only-insecure-secret

# Comma-separated emails granted the admin role on Google sign-in
ADMIN_EMAILS=

# Port the Express server listens on
PORT=3001
